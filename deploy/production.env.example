# Domain configured in the Baota website, without https://
DOMAIN=trip.example.com

# Generate values with: openssl rand -base64 32
POSTGRES_PASSWORD=
PLANNER_INTERNAL_TOKEN=

# Server-side keys: never commit actual values or use VITE_ prefixes.
AMAP_WEB_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Browser-visible map tile configuration. Use a provider you are licensed to use.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=地图数据服务商
VITE_MAP_COORDINATE_SYSTEM=wgs84

RATE_LIMIT_PER_MINUTE=120
