# Domain configured in the Baota website, without https://
DOMAIN=trip.example.com
# Use / when this app has its own domain. Use a path such as /tripbeam when
# it is reverse-proxied below another website.
TRIPBEAM_BASE_PATH=/tripbeam

# Generate values with: openssl rand -base64 32
POSTGRES_PASSWORD=
PLANNER_INTERNAL_TOKEN=

# Server-side keys: never commit actual values or use VITE_ prefixes.
AMAP_WEB_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Browser-visible AMap JavaScript API credentials. Create a separate "Web端
# (JS API)" key, restrict it to DOMAIN in the AMap console, and never reuse
# AMAP_WEB_KEY here. The security code is needed only if it is enabled there.
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_JS_CODE=

RATE_LIMIT_PER_MINUTE=120
