# Do not commit a real secret. Set this in your shell or deployment secret store.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=10000
# Optional MVP Agent orchestration through a Dify Workflow. When set, the
# workflow must return { intent, patch, edit? } in its final outputs.
DIFY_API_KEY=
DIFY_BASE_URL=http://127.0.0.1
DIFY_WORKFLOW_PATH=/v1/workflows/run
AMAP_WEB_KEY=
# Local-only fallback with deterministic demo POIs and legs. Keep false in production.
DEMO_MAP=false
# Optional: PostgreSQL in production. Omit for single-process local file storage.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_CA_CERT_PATH=
DATABASE_POOL_MAX=10
# Optional: comma-separated allowed browser origins.
WEB_ORIGIN=http://127.0.0.1:4173,http://localhost:4173
API_PORT=3101
API_HOST=127.0.0.1
RATE_LIMIT_PER_MINUTE=120
TRUST_PROXY=false
# Optional shared secret for Dify -> deterministic Planner HTTP calls.
PLANNER_INTERNAL_TOKEN=
# Optional file location for anonymous session state.
TRIPBEAM_SESSION_FILE=
# Unused sessions and unsaved drafts are removed after this many inactive days.
TRIPBEAM_DRAFT_TTL_DAYS=30
