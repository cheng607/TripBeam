VITE_API_BASE_URL=http://127.0.0.1:3101
# Required for production: use a licensed commercial XYZ tile provider.
# The browser-visible key must be restricted to the production web domain.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=地图数据服务商
# Use gcj02 for mainland China providers such as AMap; use wgs84 for Mapbox/MapTiler.
VITE_MAP_COORDINATE_SYSTEM=wgs84
